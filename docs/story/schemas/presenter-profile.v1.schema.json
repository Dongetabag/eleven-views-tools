{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elevenviews.io/schemas/story/presenter-profile.v1.schema.json",
  "title": "Atlas Presenter Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profileId", "version", "status", "identity", "voice", "presentation", "sourceRefs", "verifiedAt"],
  "properties": {
    "schema": { "const": "atlas.presenter-profile.v1" },
    "profileId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "type": "string", "enum": ["draft", "approved", "disabled", "superseded"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "photoAssetRef"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "role": { "type": "string", "minLength": 1, "maxLength": 200 },
        "photoAssetRef": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "displayName": { "type": "string", "maxLength": 160 }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "style", "speed", "language"],
      "properties": {
        "source": { "type": "string", "enum": ["recorded", "uploaded", "elevenlabs"] },
        "provider": { "type": "string", "enum": ["local", "elevenlabs", "other"] },
        "voiceId": { "type": "string", "maxLength": 300 },
        "model": { "type": "string", "maxLength": 200 },
        "style": { "type": "string", "enum": ["founder", "teacher", "sales", "technical", "documentary", "custom"] },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "language": { "type": "string", "minLength": 2, "maxLength": 35 },
        "settings": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "pronunciations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "pronunciation"],
            "properties": {
              "term": { "type": "string", "minLength": 1, "maxLength": 120 },
              "pronunciation": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "visibility", "waveform", "captionStyle"],
      "properties": {
        "preset": { "type": "string", "enum": ["minimal", "founder", "podcast", "voice-only", "tutorial", "custom"] },
        "visibility": { "type": "string", "enum": ["auto", "always", "never", "narration-only"] },
        "waveform": { "type": "string", "enum": ["compact", "line", "bars", "none"] },
        "captionStyle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "introSound": { "type": "string", "maxLength": 120 },
        "outroSound": { "type": "string", "maxLength": 120 }
      }
    },
    "assets": { "type": "array", "items": { "$ref": "common.v1.schema.json#/$defs/assetRef" } },
    "sourceRefs": { "type": "array", "items": { "$ref": "common.v1.schema.json#/$defs/sourceRef" }, "minItems": 1 },
    "verifiedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "approvedBy": { "$ref": "common.v1.schema.json#/$defs/identifier" }
  }
}
